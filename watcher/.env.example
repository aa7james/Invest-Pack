# Copy this file to `.env` (same folder) on the Bloomberg PC and fill in the values.
# `.env` is git-ignored and must NEVER be committed.

# Supabase project URL (same one the dashboard uses).
SUPABASE_URL=https://knciqlbngtmsgmhnbfce.supabase.co

# The SECRET key (service_role). This bypasses RLS so the watcher can write data.
# Paste it here on the Bloomberg PC only. Do NOT put it in the dashboard or in git.
SUPABASE_SECRET_KEY=paste_the_sb_secret_key_here

# Optional: how far back the first backfill should reach (ISO date).
BACKFILL_START=2001-01-01
